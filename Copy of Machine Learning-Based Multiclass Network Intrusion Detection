luated models. To understand its behavior across individual traffic categories, a detailed class-level evaluation is performed using precision, recall, and F1-score.\n","\n","Class-level evaluation is particularly important for intrusion detection because a high overall accuracy can conceal poor performance on less represented attack categories."],"metadata":{"id":"agEFzMDFebSK"}},{"cell_type":"code","source":["# XGBoost Classification Report\n","\n","from sklearn.metrics import classification_report\n","import pandas as pd\n","\n","xgb_report = classification_report(\n","    y_test_encoded,\n","    y_pred_xgb_encoded,\n","    target_names=label_encoder.classes_,\n","    output_dict=True,\n","    zero_division=0\n",")\n","\n","xgb_report_df = pd.DataFrame(xgb_report).transpose()\n","\n","display(xgb_report_df.round(4))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":519},"id":"EE_diUHZed79","executionInfo":{"status":"ok","timestamp":1791495891666,"user_tz":420,"elapsed":127,"user":{"displayName":"Alkamah Sakilur Rashid","userId":"16417049601801544653"}},"outputId":"a136ed7e-a68a-4406-df29-14aebea9d900"},"execution_count":39,"outputs":[{"output_type":"display_data","data":{"text/plain":["                          precision  recall  f1-score     support\n","BENIGN                       0.9988  0.9987    0.9987   9846.0000\n","Bot                          0.9873  0.9923    0.9898    391.0000\n","DDoS                         0.9999  0.9999    0.9999  10000.0000\n","DoS GoldenEye                0.9995  0.9990    0.9993   2057.0000\n","DoS Hulk                     0.9993  0.9992    0.9993   7598.0000\n","DoS Slowhttptest             0.9971  0.9933    0.9952   1046.0000\n","DoS slowloris                0.9954  0.9963    0.9958   1077.0000\n","FTP-Patator                  1.0000  1.0000    1.0000   1187.0000\n","PortScan                     0.9994  0.9997    0.9996   7878.0000\n","SSH-Patator                  1.0000  1.0000    1.0000    644.0000\n","Web